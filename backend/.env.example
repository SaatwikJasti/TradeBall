# Local Docker defaults only. Do not use these values in production.
# Spring Boot does not load this file automatically; copy values into the shell or host env.
DATABASE_URL=jdbc:postgresql://localhost:5432/tradeball
DATABASE_USERNAME=tradeball
DATABASE_PASSWORD=tradeball
# Optional pool overrides (defaults match Hikari/Spring Boot).
# DATABASE_MAX_POOL_SIZE=10
# DATABASE_CONNECTION_TIMEOUT_MS=30000
# DATABASE_IDLE_TIMEOUT_MS=600000
# DATABASE_MAX_LIFETIME_MS=1800000
REDIS_HOST=localhost
REDIS_PORT=6379
# Replace with a randomly generated value of at least 32 bytes for any shared environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
NBA_API_BASE_URL=https://api.server.nbaapi.com
NBA_API_SEASON=2025
NBA_API_USE_DEV_FALLBACK=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,capacitor://localhost

# ---------------------------------------------------------------------------
# Production / Supabase PostgreSQL (set in the cloud host — never commit)
# Convert the dashboard URI to JDBC. Do not paste a postgres:// URL.
# Prefer the direct db host (port 5432) or the session-mode pooler (also 5432).
# Do not use the transaction pooler (port 6543) while Flyway runs on this datasource.
#
# DATABASE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
# DATABASE_USERNAME=USERNAME
# DATABASE_PASSWORD=PASSWORD
# DATABASE_MAX_POOL_SIZE=10
# FLYWAY_ENABLED=true
# ---------------------------------------------------------------------------
