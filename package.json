{
  "name": "traderank-app",
  "version": "1.0.0",
  "description": "TradeRank - NBA Fantasy Trade Analyzer",
  "scripts": {
    "sync": "cap sync android",
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
